<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ============ HEADER / COUNTDOWN ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_label"
                android:textColor="#B8C6D9"
                android:textSize="12sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvCountdownDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_days"
                android:textColor="#B8C6D9"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#33465F" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_target_date"
                        android:textColor="#8E9EB2"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvTargetDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_cards_mastered"
                        android:textColor="#8E9EB2"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvMastered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0 / 0"
                        android:textColor="#C9A227"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ============ CARD ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="@string/section_card"
            android:textColor="#1E3A5F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="22dp"
            android:minHeight="230dp">

            <TextView
                android:id="@+id/tvCardTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#1E3A5F"
                android:background="@drawable/bg_tag"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCardQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="--"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tvCardAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="--"
                android:textColor="#4A5568"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />
        </LinearLayout>

        <!-- ============ CONTROLS ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_prev"
                android:textColor="#1E3A5F"
                android:background="@drawable/bg_btn_outline"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnReveal"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.4"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_reveal_show"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_solid"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_next"
                android:textColor="#1E3A5F"
                android:background="@drawable/bg_btn_outline"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- ============ MASTERED TOGGLE ============ -->
        <Button
            android:id="@+id/btnMastered"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_mark_mastered"
            android:textColor="#1E3A5F"
            android:background="@drawable/bg_btn_outline"
            android:textAllCaps="false" />

        <!-- ============ PROGRESS ============ -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/hint_swipe"
            android:textColor="#8E9EB2"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
